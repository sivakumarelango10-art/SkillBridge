# Server & Environment
PORT=5000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:3000

# Database (PostgreSQL via Prisma)
# In Docker: postgresql://postgres:postgres@postgres:5432/skillbridge?schema=public
# On Local Machine:
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/skillbridge?schema=public"

# Authentication
JWT_SECRET="skillbridge_secure_jwt_session_secret_2026_xyz"
SESSION_COOKIE_NAME="sb_session"

# AI Provider Configuration
# Supported providers: "groq" | "gemini" | "openai" | "heuristic" (zero-dependency fallback)
AI_PROVIDER="groq"
AI_MODEL="openai/gpt-oss-120b"
GROQ_API_KEY=""
GEMINI_API_KEY=""
OPENAI_API_KEY=""

# File Storage (local disk with S3-compatible interface)
STORAGE_DIR="./uploads"
MAX_FILE_SIZE_MB=5
